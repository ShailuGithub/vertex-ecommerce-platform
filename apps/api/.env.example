NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Auth cookies are marked Secure whenever NODE_ENV=production by default,
# which browsers silently drop over plain HTTP - this breaks login with no
# visible error. Leave unset once you have TLS in front of the API; set to
# false only for a production deployment still running on plain HTTP.
# COOKIE_SECURE=false

# Microsoft SQL Server connection
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=
DB_PASSWORD=
DB_NAME=vertex_ecommerce
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Merchant (store owner/staff/platform admin) JWT secrets - generate long random strings, never reuse across environments
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Customer (storefront shopper) JWT secrets - must be different from the merchant secrets above
CUSTOMER_JWT_SECRET=
CUSTOMER_JWT_REFRESH_SECRET=

# Used to encrypt each store's own Razorpay credentials at rest (AES-256-GCM). Generate once, never rotate without a migration plan.
ENCRYPTION_KEY=

# Local disk upload directory (relative to apps/api) - files are organized under uploads/<storeId>/
UPLOAD_DIR=uploads
