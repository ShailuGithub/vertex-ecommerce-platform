NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side (SSR) requests use this instead of NEXT_PUBLIC_API_URL. Keep it
# pointed at localhost/internal address when the API runs on the same host -
# there's no reason for the Node server to hairpin out through its own public
# IP to reach a process on the same machine, and that path often isn't even
# open to the internet.
INTERNAL_API_URL=http://localhost:3001
