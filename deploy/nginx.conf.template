# Nginx reverse proxy for VertexECommerce (storefront + admin + api on subdomains)
#
# Replace YOURDOMAIN.COM with your real domain before use, then:
#   sudo cp deploy/nginx.conf.template /etc/nginx/sites-available/vertex
#   sudo ln -s /etc/nginx/sites-available/vertex /etc/nginx/sites-enabled/vertex
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d storefront.YOURDOMAIN.COM -d admin.YOURDOMAIN.COM -d api.YOURDOMAIN.COM
#
# No domain yet? Skip this file for now and hit the apps directly on
# http://<server-ip>:3000 (storefront), :3002 (admin), :3001 (api) - just
# make sure your firewall/security group allows those ports. Come back to
# this once you have a domain to point at the server's IP.

# --- Storefront: storefront.YOURDOMAIN.COM -> :3000 ---
server {
    listen 80;
    server_name storefront.YOURDOMAIN.COM;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# --- Admin: admin.YOURDOMAIN.COM -> :3002 ---
server {
    listen 80;
    server_name admin.YOURDOMAIN.COM;

    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# --- API: api.YOURDOMAIN.COM -> :3001 (also serves /uploads directly from disk) ---
server {
    listen 80;
    server_name api.YOURDOMAIN.COM;

    # Matches the 5MB limit set in apps/api/src/uploads/uploads.module.ts, plus
    # headroom for multipart overhead - nginx's 1MB default would otherwise
    # 413 real product photos before they ever reach the app.
    client_max_body_size 6M;

    # Serve uploaded images directly from disk instead of proxying through Node -
    # faster, and keeps the Node process free for actual API work.
    location /uploads/ {
        alias /home/YOURUSER/VertexECommerce/apps/api/uploads/;
        expires 30d;
        access_log off;
    }

    # Razorpay webhooks need the raw request body untouched - do not buffer/transform it.
    location /stores/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
